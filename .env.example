SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ANTHROPIC_API_KEY=sk-ant-...
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# From carto.com/basemaps/apikey. Ships to the browser in the tile URL, so it's
# publishable, not secret -- but keep it out of git so it can be rotated.
CARTO_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=phillypools-submissions

# Leave unset locally to use SQLite; Railway sets this automatically via Postgres add-on:
# DATABASE_URL=postgresql://...

# Railway env vars to set in dashboard:
# SECRET_KEY=<generate a strong key>
# DEBUG=False
# ANTHROPIC_API_KEY=sk-ant-...
# CLOUDFLARE_TURNSTILE_SITE_KEY=<from Cloudflare Turnstile dashboard>
# CLOUDFLARE_TURNSTILE_SECRET_KEY=<from Cloudflare Turnstile dashboard>
# CARTO_API_KEY=<from carto.com/basemaps/apikey>
# (DATABASE_URL is injected automatically by Railway Postgres)
# (RAILWAY_PUBLIC_DOMAIN is injected automatically by Railway)
