# Railway env vars to set in dashboard:
# SECRET_KEY=<generate a strong key>
# DEBUG=False
# ANTHROPIC_API_KEY=sk-ant-...
# CLOUDFLARE_TURNSTILE_SITE_KEY=<from Cloudflare Turnstile dashboard>
# CLOUDFLARE_TURNSTILE_SECRET_KEY=<from Cloudflare Turnstile dashboard>
# (DATABASE_URL is injected automatically by Railway Postgres)
# (RAILWAY_PUBLIC_DOMAIN is injected automatically by Railway)
